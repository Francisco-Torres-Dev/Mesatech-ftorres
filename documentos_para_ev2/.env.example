# ==============================================================================
# MesaTech Cloud - Archivo de Ejemplo de Variables de Entorno (.env.example)
# Evaluación Parcial 2 - DSY1107 - Desarrollo Cloud Native I
# Integrantes: Francisco Torres — Kevin Mesías
# NOTA: Valores ficticios y seguros para entrega académica. Cero secretos reales.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Configuración de RabbitMQ (EC2 C)
# ------------------------------------------------------------------------------
RABBITMQ_DEFAULT_USER=admin_user
RABBITMQ_DEFAULT_PASS=admin_password_ejemplo
RABBITMQ_DEFAULT_VHOST=/
RABBITMQ_HOST=172.31.13.15
RABBITMQ_PORT=5672
RABBITMQ_VHOST=mesatech

# Usuarios de Aplicación para RabbitMQ:
RABBITMQ_USER_CATALOGO=publicador_catalogo
RABBITMQ_PASS_CATALOGO=catalogo_password_ejemplo

RABBITMQ_USER_SOLICITUDES=consumidor_solicitudes
RABBITMQ_PASS_SOLICITUDES=solicitudes_password_ejemplo

# Recursos de Mensajería:
RABBITMQ_EXCHANGE=catalogo.exchange
RABBITMQ_QUEUE=solicitudes.catalogo.queue
RABBITMQ_ROUTING_KEY=categoria.creada

# ------------------------------------------------------------------------------
# 2. Configuración de Bases de Datos Amazon RDS PostgreSQL 16
# ------------------------------------------------------------------------------
# RDS Catálogo (Propiedad de ms-catalogo)
RDS_CATALOGO_HOST=mesatech-rds-catalogo.xxxxxx.us-east-1.rds.amazonaws.com
RDS_CATALOGO_PORT=5432
RDS_CATALOGO_DB=mesatech_catalogo
RDS_CATALOGO_USER=db_admin_catalogo
RDS_CATALOGO_PASS=db_pass_ejemplo

# RDS Solicitudes (Propiedad de ms-solicitudes)
RDS_SOLICITUDES_HOST=mesatech-rds-solicitudes.xxxxxx.us-east-1.rds.amazonaws.com
RDS_SOLICITUDES_PORT=5432
RDS_SOLICITUDES_DB=mesatech_solicitudes
RDS_SOLICITUDES_USER=db_admin_solicitudes
RDS_SOLICITUDES_PASS=db_pass_ejemplo

# ------------------------------------------------------------------------------
# 3. Configuración de Microservicios y BFF
# ------------------------------------------------------------------------------
BFF_PORT=8080
CATALOGO_PORT=8081
SOLICITUDES_PORT=8082

CATALOGO_SERVICE_URL=http://localhost:8081
SOLICITUDES_SERVICE_URL=http://172.31.4.52:8082

# ------------------------------------------------------------------------------
# 4. Configuración de Seguridad Microsoft Entra ID y AWS API Gateway
# ------------------------------------------------------------------------------
VITE_AUTH_MODE=entra
VITE_API_URL=https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com
VITE_ENTRA_TENANT_ID=2b28c657-3169-48ee-91b9-d36cede4fe70
VITE_ENTRA_CLIENT_ID=964cf08d-0742-47e1-bdf7-1b912dc8b506
VITE_ENTRA_REDIRECT_URI=http://localhost:5173
VITE_ENTRA_AUTHORITY=https://login.microsoftonline.com/2b28c657-3169-48ee-91b9-d36cede4fe70
VITE_ENTRA_API_SCOPE=api://964cf08d-0742-47e1-bdf7-1b912dc8b506/access_as_user
